# ============================================================
# Clinical LLM Extractor - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values below:
#   cp .env.example .env
#
# Then edit .env with your actual credentials.
# NEVER commit your .env file to version control!

# Your OpenAI-compatible API Key
OPENAI_API_KEY=your-api-key-here

# Base URL of your LLM provider
# OpenAI:       https://api.openai.com/v1
# OpenRouter:   https://openrouter.ai/api/v1
# Gemini:       https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=https://api.openai.com/v1

# Model identifier to use
# OpenAI examples:      gpt-4o | gpt-4o-mini | gpt-4-turbo
# OpenRouter examples:  openai/gpt-4o | anthropic/claude-3.5-sonnet
# Gemini examples:      gemini-1.5-pro | gemini-2.0-flash
OPENAI_MODEL=gpt-4o
